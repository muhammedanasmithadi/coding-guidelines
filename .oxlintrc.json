{
  "rules": {
    "eslint/no-unused-vars": "error",
    "eslint/no-empty": "error",
    "eslint/no-warning-comments": [
      "error",
      { "terms": ["todo", "fixme", "hack"], "location": "anywhere" }
    ],
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist/", "node_modules/", "enforce/"]
}
